# /etc/chess-base.env — read by deploy/chess-base.service (ADR-0052).
# `make install-service` copies this file there on first install only.

# Host PostgreSQL over the unix socket, peer auth as the `chessbase` role.
# `localhost` is a placeholder — SeaORM rejects an empty host; `?host=` picks the socket.
DATABASE_URL=postgres://chessbase@localhost/chessbase?host=/run/postgresql

RUST_LOG=info

# Optional: Lichess API token — enables the Masters explorer tab (ADR-0053).
# LICHESS_TOKEN=

# Optional: house LLM key for the assistant when no provider row is configured.
# ANTHROPIC_API_KEY=
